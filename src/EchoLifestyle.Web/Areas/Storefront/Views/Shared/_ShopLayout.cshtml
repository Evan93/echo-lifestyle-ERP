@inject StorefrontCatalogService Catalog
@{
    var title = ViewData["Title"] as string;
    var metaDescription = ViewData["MetaDescription"] as string;
    var noIndex = ViewData["NoIndex"] as bool? ?? false;
    var menu = await Catalog.GetMenuAsync(Context.RequestAborted);
    var activeSlug = ViewContext.RouteData.Values["slug"] as string;
    var query = Context.Request.Query["q"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@(string.IsNullOrWhiteSpace(title) ? "Echo Lifestyle" : title + " · Echo Lifestyle")</title>

    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }

    @if (noIndex)
    {
        <meta name="robots" content="noindex,follow" />
    }

    @* The logo is still a JPEG with a white background. It will show a white
       box on this dark header - replacing it with an SVG is tracked as a
       blocker in the Phase 5 design record. *@
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="shop-announce">
    Cash on delivery across Bangladesh &middot; Genuine products only
</div>

<header class="shop-header">
    <div class="container">
        <div class="shop-header__bar d-flex align-items-center gap-3">
            <a class="shop-logo" asp-route="storefront-home">Echo Lifestyle</a>

            <form class="shop-search d-none d-md-flex ms-auto" style="max-width: 360px; width: 100%;"
                  asp-route="storefront-search" method="get" role="search">
                <div class="input-group input-group-sm">
                    <input type="search" name="q" value="@query" class="form-control"
                           placeholder="Search products and brands" aria-label="Search" />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
            </form>

            <button class="btn btn-sm btn-outline-secondary d-md-none ms-auto" type="button"
                    data-bs-toggle="collapse" data-bs-target="#shopMenu"
                    aria-controls="shopMenu" aria-expanded="false" aria-label="Menu">
                Menu
            </button>
        </div>
    </div>

    <div class="shop-nav">
        <div class="container">
            <div class="collapse d-md-block" id="shopMenu">
                <nav class="d-flex flex-column flex-md-row flex-wrap py-2 py-md-0"
                     aria-label="Categories">
                    @foreach (var category in menu)
                    {
                        <a class="shop-nav__link @(category.Slug == activeSlug ? "is-active" : null)"
                           asp-route="storefront-category" asp-route-slug="@category.Slug">
                            @category.Name
                        </a>
                    }
                </nav>

                <form class="shop-search d-md-none pb-3" asp-route="storefront-search"
                      method="get" role="search">
                    <div class="input-group input-group-sm">
                        <input type="search" name="q" value="@query" class="form-control"
                               placeholder="Search products and brands" aria-label="Search" />
                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="shop-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 col-md-5">
                <div class="shop-logo text-white mb-2">Echo Lifestyle</div>
                <p class="small mb-0" style="max-width: 32ch;">
                    Skincare, haircare and cosmetics, sourced genuine and delivered across
                    Bangladesh.
                </p>
            </div>

            <div class="col-6 col-md-3">
                <div class="shop-footer__title">Shop</div>
                <ul class="list-unstyled small mb-0">
                    @foreach (var category in menu.Take(6))
                    {
                        <li class="mb-1">
                            <a asp-route="storefront-category" asp-route-slug="@category.Slug">
                                @category.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="col-6 col-md-4">
                <div class="shop-footer__title">Ordering</div>
                <p class="small mb-2">
                    Order here, or message us on Facebook or Instagram. We confirm every order
                    by phone before it ships.
                </p>
                <p class="small mb-0">Cash on delivery only, for now.</p>
            </div>
        </div>

        <div class="border-top border-secondary-subtle mt-4 pt-3 small opacity-75">
            &copy; @DateTime.UtcNow.Year Echo Lifestyle
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
