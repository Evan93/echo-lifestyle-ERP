@model PlacedOrder

<div class="container py-5">
    <div class="mx-auto text-center" style="max-width: 34rem;">

        <div class="shop-done__mark" aria-hidden="true">&#10003;</div>

        <h1 class="shop-display h2 mb-2">Thank you, @Model.RecipientName</h1>

        <p class="text-muted">
            Your order is with us. We will call to confirm it before anything ships.
        </p>

        <div class="shop-summary text-start mt-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Order number</span>
                <code>@Model.Number</code>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Delivering to</span>
                <span>@Model.DistrictName</span>
            </div>

            <div class="d-flex justify-content-between border-top pt-2">
                <span class="fw-semibold">To pay on delivery</span>
                <span class="fw-semibold">&#2547; @Model.GrandTotal.ToString("N0")</span>
            </div>
        </div>

        <p class="text-muted small mt-4">
            Keep the order number &mdash; quote it if you message us about this parcel.
            Payment is cash to the courier when it arrives.
        </p>

        <div class="d-flex gap-2 justify-content-center mt-2 flex-wrap">
            <a class="btn btn-shop" asp-route="storefront-home">Keep shopping</a>

            @* Prefilled with the order number, so the one moment somebody has
               it in front of them is the moment they can reach - and bookmark -
               the page that needs it. The phone stays for them to type. *@
            <a class="btn btn-outline-secondary"
               href="@Url.RouteUrl("storefront-track", new { order = Model.Number })">
                Track this order
            </a>
        </div>

        @* The conversion. This fires exactly once per order without any guard,
           because the page is built from TempData: a refresh finds it gone and
           redirects home rather than re-rendering. Worth knowing, because the
           usual way this goes wrong is a customer refreshing their receipt and
           inflating the conversion count the ad budget is judged on. *@
        <script>
            window.echo.track("Purchase", {
                currency: "BDT",
                value: @Model.GrandTotal.ToString(System.Globalization.CultureInfo.InvariantCulture),
                transaction_id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Number))
            });
        </script>
    </div>
</div>
