@using EchoLifestyle.Domain.Administration
@using EchoLifestyle.Web.Areas.BackOffice.Models.Branches
@model BranchFormModel
@{
    ViewData["Subtitle"] = Model.IsNew
        ? "Create a selling location"
        : "Edit this branch and the warehouses it draws stock from";

    var action = Model.IsNew ? "Create" : "Edit";
}

<form asp-action="@action" asp-route-id="@(Model.IsNew ? null : (long?)Model.Id)" method="post" novalidate>
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                            <div class="form-text">Appears on documents. Letters, numbers and dashes.</div>
                        </div>

                        <div class="col-12 col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" class="form-select"
                                    asp-items="Html.GetEnumSelectList<BranchType>()"></select>
                        </div>

                        <div class="col-12 col-md-8">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="AddressLine1" class="form-label"></label>
                            <input asp-for="AddressLine1" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Status</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                        <div class="form-text">Inactive branches keep their history but cannot be used on new documents.</div>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="AllowNegativeStock" class="form-check-input" role="switch" />
                        <label asp-for="AllowNegativeStock" class="form-check-label"></label>
                        <div class="form-text">
                            Off by default. Turning this on lets documents drive stock below zero at this
                            branch, and the user still needs the
                            <code>Inventory.Stock.AllowNegative</code> permission. The change is recorded
                            in the audit trail.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card mb-3">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Warehouses</span>
                    <span class="text-muted small fw-normal">
                        Tick the warehouses this branch can draw from, and mark exactly one as primary.
                    </span>
                </div>

                @if (Model.Warehouses.Count == 0)
                {
                    <div class="card-body">
                        <div class="echo-empty">
                            No warehouses exist yet. Create one first, then link it here.
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5rem;">Linked</th>
                                    <th>Warehouse</th>
                                    <th style="width: 7rem;">Primary</th>
                                    <th style="width: 9rem;">Pick order</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Warehouses.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" asp-for="Warehouses[i].WarehouseId" />
                                            <input type="hidden" asp-for="Warehouses[i].WarehouseCode" />
                                            <input type="hidden" asp-for="Warehouses[i].WarehouseName" />
                                            <input class="form-check-input" type="checkbox"
                                                   asp-for="Warehouses[i].IsLinked" />
                                        </td>
                                        <td>
                                            <code>@Model.Warehouses[i].WarehouseCode</code>
                                            <span class="ms-2">@Model.Warehouses[i].WarehouseName</span>
                                        </td>
                                        <td>
                                            @* A checkbox rather than a radio so the posted value round-trips
                                               per row; the service rejects anything but exactly one. *@
                                            <input class="form-check-input js-primary" type="checkbox"
                                                   asp-for="Warehouses[i].IsPrimary" />
                                        </td>
                                        <td>
                                            <input asp-for="Warehouses[i].Priority" type="number" min="1" max="999"
                                                   class="form-control form-control-sm" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-echo" data-submit-once>
            @(Model.IsNew ? "Create branch" : "Save changes")
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Only one warehouse can be primary. Enforced server-side and by a
            // filtered unique index in the database; this just stops the user
            // submitting something that was always going to be rejected.
            document.addEventListener("change", function (event) {
                var target = event.target;

                if (target.classList.contains("js-primary") && target.checked) {
                    document.querySelectorAll(".js-primary").forEach(function (other) {
                        if (other !== target) {
                            other.checked = false;
                        }
                    });

                    // Marking a warehouse primary implies linking it.
                    var row = target.closest("tr");
                    var linked = row ? row.querySelector('input[type="checkbox"]') : null;
                    if (linked) {
                        linked.checked = true;
                    }
                }
            });
        })();
    </script>
}
