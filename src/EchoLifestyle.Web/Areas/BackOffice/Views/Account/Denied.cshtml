@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h1 class="h5">Access denied</h1>
                <p class="text-muted mb-3">
                    Your account does not have permission to open that page. If you believe it should,
                    ask an owner to review your role.
                </p>
                <a class="btn btn-outline-dark btn-sm"
                   asp-area="BackOffice" asp-controller="Dashboard" asp-action="Index">
                    Back to dashboard
                </a>
            </div>
        </div>
    </div>
</div>
