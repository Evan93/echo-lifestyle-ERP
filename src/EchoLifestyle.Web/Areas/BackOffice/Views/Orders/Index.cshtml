@using EchoLifestyle.Application.Sales.Orders
@{
    ViewData["Title"] = "Orders";
    ViewData["Subtitle"] = "From the message that started it to the money that came back.";

    var workload = ViewData["Workload"] as OrderWorkload ?? new OrderWorkload();
    var canCreate = ViewData["CanCreate"] as bool? ?? false;
    var showCost = CurrentUser.HasPermission(Permissions.Catalog.CostPriceView);
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100 js-tile" role="button" data-status="Draft">
            <div class="card-body">
                <div class="text-muted small">Drafts</div>
                <div class="fs-4 fw-semibold">@workload.Draft</div>
                <div class="text-muted small">not yet confirmed</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100 js-tile @(workload.Confirmed + workload.Packed > 0 ? "border-warning" : null)"
             role="button" data-status="Confirmed">
            <div class="card-body">
                <div class="text-muted small">To pack &amp; ship</div>
                <div class="fs-4 fw-semibold">@(workload.Confirmed + workload.Packed)</div>
                <div class="text-muted small">stock reserved, still here</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100 js-tile" role="button" data-status="Dispatched">
            <div class="card-body">
                <div class="text-muted small">With couriers</div>
                <div class="fs-4 fw-semibold">@workload.Dispatched</div>
                <div class="text-muted small">shipped, not settled</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100 js-tile @(workload.AmountOutstanding > 0 ? "border-danger" : null)"
             role="button" data-awaiting="1">
            <div class="card-body">
                <div class="text-muted small">Cash outstanding</div>
                <div class="fs-4 fw-semibold @(workload.AmountOutstanding > 0 ? "text-danger" : null)">
                    &#2547; @workload.AmountOutstanding.ToString("N0")
                </div>
                <div class="text-muted small">with couriers and customers</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label mb-1 small text-muted" for="statusFilter">Status</label>
            <select id="statusFilter" class="form-select form-select-sm" style="width: auto;">
                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Packed">Packed</option>
                <option value="Dispatched">Dispatched</option>
                <option value="Delivered">Delivered</option>
                <option value="Returned">Returned</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        <div>
            <label class="form-label mb-1 small text-muted" for="fromDate">From</label>
            <input id="fromDate" type="date" class="form-control form-control-sm" style="width: auto;" />
        </div>

        <div>
            <label class="form-label mb-1 small text-muted" for="toDate">To</label>
            <input id="toDate" type="date" class="form-control form-control-sm" style="width: auto;" />
        </div>

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="awaitingCashOnly" />
            <label class="form-check-label small" for="awaitingCashOnly">Money still owed</label>
        </div>
    </div>

    @if (canCreate)
    {
        <a class="btn btn-echo btn-sm" asp-action="Create">New order</a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table id="ordersGrid" class="table table-hover align-middle mb-0 w-100">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Going to</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var detailsUrlTemplate = "@Url.Action("Details", new { id = "__id__" })";

            function money(value) {
                return "৳ " + Number(value || 0).toLocaleString("en-BD", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            var statusVariant = {
                Draft: "light border",
                Confirmed: "warning",
                Packed: "info",
                Dispatched: "primary",
                Delivered: "success",
                Cancelled: "secondary",
                Returned: "danger"
            };

            var grid = echo.grid("#ordersGrid", {
                url: "@Url.Action("Data")",
                order: [],
                emptyMessage: "No orders yet.",
                searchPlaceholder: "Search number, customer, mobile, consignment or product...",

                filters: function () {
                    return {
                        status: $("#statusFilter").val() || null,
                        awaitingCashOnly: $("#awaitingCashOnly").is(":checked"),
                        from: $("#fromDate").val() || null,
                        to: $("#toDate").val() || null
                    };
                },

                columns: [
                    {
                        data: "number",
                        name: "number",
                        render: function (number, type, row) {
                            var line = echo.render.code(number);

                            if (row.consignmentNumber) {
                                line += '<div class="text-muted small">' +
                                    echo.escape(row.courierName || "") + " · " +
                                    echo.escape(row.consignmentNumber) + "</div>";
                            }

                            return line;
                        }
                    },
                    {
                        data: "customerName",
                        name: "customer",
                        render: function (name, type, row) {
                            return echo.escape(name) +
                                '<div class="text-muted small font-monospace">' +
                                echo.escape(row.customerPhone) + "</div>";
                        }
                    },
                    { data: "orderDate", name: "date", render: echo.escape },
                    {
                        data: "districtName",
                        orderable: false,
                        render: function (district, type, row) {
                            return echo.escape(district) +
                                '<div class="text-muted small">' + row.lineCount + " line(s)</div>";
                        }
                    },
                    {
                        data: "grandTotal",
                        name: "total",
                        className: "text-end",
                        render: function (total, type, row) {
                            var line = money(total);
                            var outstanding = Number(row.grandTotal) - Number(row.amountCollected);

                            // What is still owed is the number a cash-on-delivery
                            // business actually watches.
                            if (outstanding > 0 && row.status !== "Draft"
                                && row.status !== "Cancelled" && row.status !== "Returned") {
                                line += '<div class="text-danger small">' +
                                    money(outstanding) + " owed</div>";
                            } else if (row.status === "Delivered") {
                                line += '<div class="text-success small">paid</div>';
                            }

                            return line;
                        }
                    },
                    {
                        data: "status",
                        orderable: false,
                        render: function (status) {
                            return echo.render.badge(status, statusVariant[status] || "secondary");
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        className: "text-end",
                        render: function (id) {
                            return '<a class="btn btn-sm btn-outline-secondary" href="' +
                                echo.escape(detailsUrlTemplate.replace("__id__", id)) + '">Open</a>';
                        }
                    }
                ]
            });

            // The tiles are filters, not decoration.
            jQuery(".js-tile").on("click", function () {
                var $tile = jQuery(this);

                $("#awaitingCashOnly").prop("checked", !!$tile.attr("data-awaiting"));
                $("#statusFilter").val($tile.attr("data-status") || "");

                grid.ajax.reload(null, true);
            });

            echo.bindFilters(grid, "#statusFilter, #awaitingCashOnly, #fromDate, #toDate");
        })();
    </script>
}
