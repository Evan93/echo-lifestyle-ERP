@using EchoLifestyle.Domain.Sales
@using EchoLifestyle.Web.Areas.BackOffice.Models.Sales
@model OrderFormModel
@{
    ViewData["Subtitle"] = Model.IsEdit
        ? "A draft. Nothing is reserved until it is confirmed."
        : "Take the order. Stock is only committed when you confirm it.";
}

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.Id : null)"
      method="post" novalidate autocomplete="off">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
    }

    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="CustomerName" id="CustomerName" />

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Who it is for</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="customerSearch">Customer</label>
                            <div class="position-relative" id="customerSearchWrapper">
                                <input id="customerSearch" class="form-control"
                                       value="@Model.CustomerName"
                                       placeholder="Name or mobile number..." />
                                <div id="customerSearchResults"
                                     class="list-group position-absolute w-100 shadow"
                                     style="z-index: 30; display: none; max-height: 20rem; overflow-y: auto;"></div>
                            </div>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            <div class="form-text">
                                Paste a number straight from a chat &mdash; any format works.
                                <a asp-controller="Customers" asp-action="Create" target="_blank">
                                    New customer
                                </a>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CustomerAddressId" class="form-label"></label>
                            <select asp-for="CustomerAddressId" id="CustomerAddressId"
                                    class="form-select"></select>
                            <div class="form-text">
                                Copied onto the order, so a later change of address never rewrites
                                where this parcel went.
                            </div>
                        </div>

                        <div class="col-6 col-md-4">
                            <label asp-for="Channel" class="form-label"></label>
                            <select asp-for="Channel" class="form-select"
                                    asp-items="Html.GetEnumSelectList<SalesChannel>()"></select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label asp-for="WarehouseId" class="form-label"></label>
                            <select asp-for="WarehouseId" id="WarehouseId" class="form-select">
                                @foreach (var warehouse in Model.Warehouses)
                                {
                                    <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">
                                        @warehouse.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label asp-for="OrderDate" class="form-label"></label>
                            <input asp-for="OrderDate" class="form-control" type="date" />
                            <div class="form-text">Blank means today.</div>
                        </div>

                        @if (Model.Branches.Count > 1)
                        {
                            <div class="col-6 col-md-4">
                                <label asp-for="BranchId" class="form-label"></label>
                                <select asp-for="BranchId" class="form-select">
                                    @foreach (var branch in Model.Branches)
                                    {
                                        <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">
                                            @branch.Name
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="BranchId" />
                        }
                    </div>

                    <div class="alert alert-danger py-2 small mt-3 mb-0" id="blockedWarning"
                         style="display: none;">
                        <strong>This customer is blocked.</strong>
                        <span class="js-reason"></span>
                        The order will be refused when you save it.
                    </div>

                    <div class="alert alert-info py-2 small mt-3 mb-0" id="repriceNotice"
                         style="display: none;">
                        Prices and availability depend on the customer and the warehouse. Remove and
                        re-add any line you want repriced &mdash; the server prices everything again
                        when you save, so what is stored will be correct either way.
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">What they are buying</span>
                    <span class="text-muted small"><span id="lineCount">0</span> line(s)</span>
                </div>

                <div class="card-body border-bottom">
                    <label class="form-label" for="lineSearch">Add a product</label>
                    <div class="position-relative" id="lineSearchWrapper">
                        <input id="lineSearch" class="form-control"
                               placeholder="Scan a barcode, or type an SKU, product or brand..." />
                        <div id="lineSearchResults" class="list-group position-absolute w-100 shadow"
                             style="z-index: 20; display: none; max-height: 22rem; overflow-y: auto;"></div>
                    </div>
                    <div class="form-text">
                        The figure shown is what can be <em>promised</em> &mdash; on hand less what
                        other confirmed orders are already holding.
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width: 14rem;">Product</th>
                                <th style="width: 7rem;" class="text-end">Qty</th>
                                <th style="width: 9rem;" class="text-end">Price</th>
                                <th style="width: 8rem;" class="text-end">Discount</th>
                                <th style="width: 9rem;" class="text-end">Line total</th>
                                <th style="width: 3rem;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineRows">
                            @for (var i = 0; i < Model.Lines.Count; i++)
                            {
                                var index = i;
                                var line = Model.Lines[index];

                                if (line.ProductVariantId == 0)
                                {
                                    continue;
                                }

                                <tr data-line="@index" data-variant="@line.ProductVariantId"
                                    data-available="0">
                                    <td>
                                        <div class="fw-semibold">@line.Description</div>
                                        <div class="small text-muted">@line.Sku</div>
                                        <input type="hidden" asp-for="Lines[index].ProductVariantId" />
                                        <input type="hidden" asp-for="Lines[index].Sku" />
                                        <input type="hidden" asp-for="Lines[index].Description" />
                                    </td>
                                    <td>
                                        <input asp-for="Lines[index].Quantity" type="number"
                                               step="0.01" min="0.01"
                                               class="form-control form-control-sm text-end js-quantity" />
                                    </td>
                                    <td>
                                        <input asp-for="Lines[index].UnitPrice" type="number"
                                               step="0.01" min="0"
                                               class="form-control form-control-sm text-end js-price" />
                                    </td>
                                    <td>
                                        <input asp-for="Lines[index].DiscountAmount" type="number"
                                               step="0.01" min="0"
                                               class="form-control form-control-sm text-end js-discount" />
                                    </td>
                                    <td class="text-end align-middle js-line-total">&mdash;</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger js-remove"
                                                title="Remove">&times;</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="noLines" class="text-center text-muted py-4"
                         style="@(Model.Lines.Any(l => l.ProductVariantId > 0) ? "display:none;" : "")">
                        Nothing added yet. Search above to start.
                    </div>
                </div>

                <div class="card-body border-top py-2" id="stockWarning" style="display: none;">
                    <p class="text-warning-emphasis small mb-0">
                        A line asks for more than can be promised. The draft saves either way &mdash;
                        confirming is what will be refused, so a delivery arriving tomorrow still
                        fills this order.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-3 position-sticky" style="top: 1rem;">
                <div class="card-header fw-semibold">Totals</div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="DiscountAmount" class="form-label small"></label>
                            <input asp-for="DiscountAmount" id="DiscountAmount" type="number"
                                   step="0.01" min="0" class="form-control form-control-sm text-end" />
                        </div>
                        <div class="col-6">
                            <label asp-for="DeliveryCharge" class="form-label small"></label>
                            <input asp-for="DeliveryCharge" id="DeliveryCharge" type="number"
                                   step="0.01" min="0" class="form-control form-control-sm text-end" />
                        </div>
                    </div>

                    <dl class="row mb-0 small">
                        <dt class="col-7 text-muted fw-normal">Goods</dt>
                        <dd class="col-5 text-end mb-1" id="subTotal">&#2547; 0.00</dd>

                        <dt class="col-7 text-muted fw-normal">Discount</dt>
                        <dd class="col-5 text-end mb-1" id="discountTotal">&#2547; 0.00</dd>

                        <dt class="col-7 text-muted fw-normal">Delivery</dt>
                        <dd class="col-5 text-end mb-1" id="deliveryTotal">&#2547; 0.00</dd>

                        <dt class="col-7 fw-semibold border-top pt-2">To collect</dt>
                        <dd class="col-5 text-end fw-semibold border-top pt-2 mb-0" id="grandTotal">
                            &#2547; 0.00
                        </dd>
                    </dl>

                    <div class="form-text mt-3">
                        A preview. The server reprices every line and recomputes every figure when you
                        save, and its numbers are the ones stored.
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Payment</div>
                <div class="card-body">
                    <select asp-for="PaymentMethod" class="form-select"
                            asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    <div class="form-text">
                        Cash on delivery for now. bKash, Nagad and cards come with payments.
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Notes</div>
                <div class="card-body">
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Wants it before Eid. Asked for the sample sachets."></textarea>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-echo" data-submit-once>
                    @(Model.IsEdit ? "Save draft" : "Save as draft")
                </button>
                <a class="btn btn-outline-secondary"
                   asp-action="@(Model.IsEdit ? "Details" : "Index")"
                   asp-route-id="@(Model.IsEdit ? Model.Id : null)">Cancel</a>
            </div>

            <p class="text-muted small mt-3">
                Saving does not commit stock. Confirm the order once the customer has said yes &mdash;
                that is what takes it off the shelf for everybody else.
            </p>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sales/order-entry.js" asp-append-version="true"></script>

    <script>
        jQuery(function () {
            echo.orderEntry({
                customerLookupUrl: "@Url.Action("Lookup", "Customers")",
                lookupUrl: "@Url.Action("Lookup")",
                addressesUrl: "@Url.Action("Addresses")",
                selectedAddressId: @Json.Serialize(Model.CustomerAddressId)
            });
        });
    </script>
}
