@using EchoLifestyle.Web
@using EchoLifestyle.Web.Areas.BackOffice.Controllers
@using EchoLifestyle.Web.Areas.BackOffice.Models
@using EchoLifestyle.Web.Security
@using EchoLifestyle.Application.Common.Authorization
@using EchoLifestyle.Application.Common.Interfaces
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@* Injected for every back-office view.

   Note the name deliberately shadows the CurrentUser *class* in
   EchoLifestyle.Web.Security: without this, `CurrentUser.HasPermission(...)`
   in a view binds to the type and fails to compile. *@
@inject ICurrentUser CurrentUser
@inject IDateTimeProvider Clock
