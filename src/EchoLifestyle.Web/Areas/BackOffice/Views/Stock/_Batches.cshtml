@using EchoLifestyle.Application.Inventory
@model IReadOnlyList<StockBatchItem>
@{
    var showCost = CurrentUser.HasPermission(Permissions.Catalog.CostPriceView);
    var today = Clock.ToBusinessDate(Clock.UtcNow);
}

<div class="p-3 bg-body-tertiary">
    @if (Model.Count == 0)
    {
        <p class="text-muted small mb-0">No batches with stock.</p>
    }
    else
    {
        <table class="table table-sm mb-0 bg-body">
            <thead>
                <tr class="small text-muted">
                    <th>Batch</th>
                    <th>Warehouse</th>
                    <th>Received</th>
                    <th>Expires</th>
                    <th class="text-end">On hand</th>
                    @if (showCost)
                    {
                        <th class="text-end">Landed cost</th>
                        <th class="text-end">Value</th>
                    }
                    <th>Supplier</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in Model)
                {
                    var expired = batch.ExpiryDate is not null && batch.ExpiryDate <= today;

                    <tr class="@(expired ? "table-danger" : null)">
                        <td>
                            @if (batch.IsAutoGenerated)
                            {
                                @* Generated, so presenting it as a batch number
                                   somebody chose would be misleading. *@
                                <span class="text-muted small">Not tracked</span>
                            }
                            else
                            {
                                <code>@batch.BatchNumber</code>
                            }
                        </td>
                        <td class="small">@batch.WarehouseName</td>
                        <td class="small">@batch.ReceivedDate.ToString("d MMM yyyy")</td>
                        <td class="small">
                            @if (batch.ExpiryDate is null)
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                            else
                            {
                                @batch.ExpiryDate.Value.ToString("d MMM yyyy")
                            }
                        </td>
                        <td class="text-end">
                            @batch.QuantityOnHand.ToString("N0")
                            @if (batch.QuantityReserved > 0m)
                            {
                                <div class="text-muted small">@batch.QuantityReserved.ToString("N0") reserved</div>
                            }
                        </td>
                        @if (showCost)
                        {
                            <td class="text-end">&#2547; @batch.LandedUnitCost.ToString("N2")</td>
                            <td class="text-end">&#2547; @batch.Value.ToString("N2")</td>
                        }
                        <td class="small text-muted">@batch.SupplierName</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="text-muted small mt-2 mb-0">
            Oldest expiry first &mdash; the order this stock should leave in. Each batch carries the cost
            actually paid for it, not a blended average.
        </p>
    }
</div>
