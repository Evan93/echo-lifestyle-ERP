@using EchoLifestyle.Application.Inventory
@using EchoLifestyle.Web.Areas.BackOffice.Controllers
@model IReadOnlyList<ExpiringBatchItem>
@{
    ViewData["Title"] = "Near expiry";
    ViewData["Subtitle"] = "Stock with a date on it. Anything already expired is listed first.";

    var warehouses = ViewData["Warehouses"] as List<WarehouseFilterOption> ?? [];
    var days = ViewData["Days"] as int? ?? 90;
    var warehouseId = ViewData["WarehouseId"] as long?;
    var showCost = CurrentUser.HasPermission(Permissions.Catalog.CostPriceView);

    var expired = Model.Where(r => r.HasExpired).ToList();
    var atRisk = Model.Where(r => !r.HasExpired).ToList();
}

<form method="get" class="d-flex align-items-end gap-2 flex-wrap mb-3">
    <div>
        <label class="form-label mb-1 small text-muted" for="days">Expiring within</label>
        <select id="days" name="days" class="form-select form-select-sm" style="width: auto;"
                onchange="this.form.submit();">
            <option value="30" selected="@(days == 30)">30 days</option>
            <option value="60" selected="@(days == 60)">60 days</option>
            <option value="90" selected="@(days == 90)">90 days</option>
            <option value="180" selected="@(days == 180)">6 months</option>
            <option value="365" selected="@(days == 365)">1 year</option>
        </select>
    </div>

    @if (warehouses.Count > 1)
    {
        <div>
            <label class="form-label mb-1 small text-muted" for="warehouseId">Warehouse</label>
            <select id="warehouseId" name="warehouseId" class="form-select form-select-sm"
                    style="width: auto;" onchange="this.form.submit();">
                <option value="">All warehouses</option>
                @foreach (var warehouse in warehouses)
                {
                    <option value="@warehouse.Id" selected="@(warehouseId == warehouse.Id)">
                        @warehouse.Name
                    </option>
                }
            </select>
        </div>
    }
</form>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            Nothing expires in the next @days days.
        </div>
    </div>
}
else
{
    @if (expired.Count > 0)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong>@expired.Count batch@(expired.Count == 1 ? "" : "es") already past date</strong>
                and still counted as sellable stock.
            </div>
            @if (showCost)
            {
                <div class="fw-semibold">
                    &#2547; @expired.Sum(r => r.ValueAtRisk).ToString("N2")
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Batch</th>
                        <th>Warehouse</th>
                        <th>Expires</th>
                        <th class="text-end">On hand</th>
                        @if (showCost)
                        {
                            <th class="text-end">Value at risk</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr class="@(row.HasExpired ? "table-danger" : null)">
                            <td>
                                <div class="fw-semibold">
                                    @row.ProductName
                                    @if (row.VariantName != "Standard")
                                    {
                                        <span class="text-muted">&middot; @row.VariantName</span>
                                    }
                                </div>
                                <div class="text-muted small">@row.Sku</div>
                            </td>
                            <td><code>@row.BatchNumber</code></td>
                            <td class="small">@row.WarehouseName</td>
                            <td>
                                <div>@row.ExpiryDate.ToString("d MMM yyyy")</div>
                                <div class="small">
                                    @if (row.HasExpired)
                                    {
                                        <span class="text-danger fw-semibold">
                                            @(-row.DaysRemaining) days ago
                                        </span>
                                    }
                                    else if (row.DaysRemaining <= 30)
                                    {
                                        <span class="text-warning-emphasis fw-semibold">
                                            in @row.DaysRemaining days
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">in @row.DaysRemaining days</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end">@row.QuantityOnHand.ToString("N0")</td>
                            @if (showCost)
                            {
                                <td class="text-end">&#2547; @row.ValueAtRisk.ToString("N2")</td>
                            }
                        </tr>
                    }
                </tbody>
                @if (showCost)
                {
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="4">Total at risk</th>
                            <th class="text-end">@Model.Sum(r => r.QuantityOnHand).ToString("N0")</th>
                            <th class="text-end">&#2547; @Model.Sum(r => r.ValueAtRisk).ToString("N2")</th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>

    <p class="text-muted small mt-3 mb-0">
        Expired stock stays on this list until it is written off &mdash; a write-off is a stock movement
        like any other, so the loss shows up in the ledger rather than quietly disappearing.
        @if (atRisk.Count > 0)
        {
            <text>Sell the oldest batches first and most of this never reaches the top of the list.</text>
        }
    </p>
}
