@using EchoLifestyle.Web.Areas.BackOffice.Models.Users
@model ResetPasswordModel
@{
    ViewData["Subtitle"] = $"Set a new password for {Model.UserName}";
}

<div class="row">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="ResetPassword" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserName" />

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">
                            At least 10 characters with upper, lower, a digit and a symbol.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    @* An administrator setting someone else's password is a
                       sensitive action, so it is recorded in the audit trail. *@
                    <div class="alert alert-light border small">
                        This is recorded in the audit trail against your account. Give the password to
                        @Model.UserName directly and ask them to change it after signing in.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-echo" data-submit-once>Set password</button>
                        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
