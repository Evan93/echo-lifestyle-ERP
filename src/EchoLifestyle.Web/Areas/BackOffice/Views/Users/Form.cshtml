@using EchoLifestyle.Web.Areas.BackOffice.Models.Users
@model UserFormModel
@{
    ViewData["Subtitle"] = Model.IsNew
        ? "Create a back-office account"
        : "Roles decide what this person can do; branches decide what data they see";

    var action = Model.IsNew ? "Create" : "Edit";
}

<form asp-action="@action" asp-route-id="@(Model.IsNew ? null : (long?)Model.Id)" method="post" novalidate>
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Account</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="UserName" class="form-label"></label>
                            <input asp-for="UserName" class="form-control" autocomplete="off"
                                   readonly="@(!Model.IsNew)" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            @if (!Model.IsNew)
                            {
                                <div class="form-text">
                                    Usernames are permanent - the audit trail refers to them.
                                </div>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        @if (Model.IsNew)
                        {
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-text">
                                    At least 10 characters with upper, lower, a digit and a symbol.
                                    Tell them to change it after their first sign-in.
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <input asp-for="Notes" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Status</div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch"
                               disabled="@Model.IsSelf" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                        <span asp-validation-for="IsActive" class="text-danger small d-block"></span>

                        @if (Model.IsSelf)
                        {
                            <div class="form-text">
                                You cannot deactivate your own account.
                            </div>
                        }
                        else
                        {
                            <div class="form-text">
                                A deactivated account keeps its history but cannot sign in.
                            </div>
                        }
                    </div>

                    @if (!Model.IsNew)
                    {
                        <hr />
                        <dl class="row small mb-0">
                            <dt class="col-5 text-muted fw-normal">Last sign-in</dt>
                            <dd class="col-7">
                                @(Model.LastLoginAtUtc is null
                                    ? "Never"
                                    : Clock.ToBusinessTime(Model.LastLoginAtUtc.Value).ToString("dd MMM yyyy HH:mm"))
                            </dd>

                            <dt class="col-5 text-muted fw-normal">Sign-in lock</dt>
                            <dd class="col-7">
                                @if (Model.IsLockedOut)
                                {
                                    <span class="badge text-bg-danger">Locked out</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not locked</span>
                                }
                            </dd>
                        </dl>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Roles</div>
                <div class="card-body">
                    @* Roles are bundles of permissions; nothing authorises on the
                       role name itself, so these can be reshaped freely. *@
                    <div class="row g-2">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            var isChecked = Model.Roles.Contains(role);
                            var inputId = $"role-{role.Replace(" ", "-", StringComparison.Ordinal)}";

                            <div class="col-12 col-sm-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Roles"
                                           value="@role" id="@inputId" checked="@isChecked" />
                                    <label class="form-check-label" for="@inputId">
                                        @role
                                        @if (role == EchoLifestyle.Application.Common.Authorization.Roles.Owner)
                                        {
                                            <span class="badge text-bg-warning ms-1">All permissions</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <span asp-validation-for="Roles" class="text-danger small d-block mt-2"></span>

                    <div class="form-text mt-2">
                        Owner holds every permission automatically, including any added later.
                        The system will not let the last active Owner lose the role.
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold">Branch access</div>
                <div class="card-body">
                    @if (Model.AvailableBranches.Count == 0)
                    {
                        <p class="text-muted small mb-0">No branches exist yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 4rem;">Access</th>
                                        <th>Branch</th>
                                        <th style="width: 6rem;">Default</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var branch in Model.AvailableBranches)
                                    {
                                        var hasAccess = Model.BranchIds.Contains(branch.Id);

                                        <tr>
                                            <td>
                                                <input class="form-check-input js-branch" type="checkbox"
                                                       name="BranchIds" value="@branch.Id"
                                                       checked="@hasAccess"
                                                       data-branch="@branch.Id" />
                                            </td>
                                            <td>
                                                <code>@branch.Code</code>
                                                <span class="ms-2">@branch.Name</span>
                                                @if (!branch.IsActive)
                                                {
                                                    <span class="badge text-bg-secondary ms-1">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <input class="form-check-input" type="radio"
                                                       name="DefaultBranchId" value="@branch.Id"
                                                       checked="@(Model.DefaultBranchId == branch.Id)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <span asp-validation-for="BranchIds" class="text-danger small d-block mt-2"></span>

                    <div class="form-text mt-2">
                        Non-owners see only data from the branches ticked here. Owners see everything
                        regardless, so branch access is optional for them.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-echo" data-submit-once>
            @(Model.IsNew ? "Create account" : "Save changes")
        </button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>

        @if (!Model.IsNew && CurrentUser.HasPermission(Permissions.Security.UserResetPassword))
        {
            <a class="btn btn-outline-secondary ms-auto"
               asp-action="ResetPassword" asp-route-id="@Model.Id">Reset password</a>
        }
    </div>
</form>

@if (!Model.IsNew && Model.IsLockedOut && CurrentUser.HasPermission(Permissions.Security.UserLock))
{
    <form asp-action="Unlock" asp-route-id="@Model.Id" method="post" class="mt-3">
        <button type="submit" class="btn btn-outline-danger btn-sm" data-submit-once>
            Clear sign-in lock
        </button>
        <span class="text-muted small ms-2">
            The account locked itself after repeated failed sign-ins.
        </span>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Marking a branch as the default implies granting access to it.
            document.addEventListener("change", function (event) {
                var target = event.target;

                if (target.name === "DefaultBranchId" && target.checked) {
                    var access = document.querySelector('.js-branch[data-branch="' + target.value + '"]');
                    if (access) {
                        access.checked = true;
                    }
                }

                // Removing access to the default branch clears the default too,
                // rather than leaving a default the user cannot reach.
                if (target.classList.contains("js-branch") && !target.checked) {
                    var radio = document.querySelector(
                        'input[name="DefaultBranchId"][value="' + target.dataset.branch + '"]');
                    if (radio && radio.checked) {
                        radio.checked = false;
                    }
                }
            });
        })();
    </script>
}
