@using EchoLifestyle.Application.Reporting
@model SpendReport
@{
    ViewData["Subtitle"] = $"{Model.From:d MMM yyyy} to {Model.To:d MMM yyyy}";
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label small text-muted" for="from">From</label>
        <input class="form-control form-control-sm" type="date" id="from" name="from"
               value="@Model.From.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label small text-muted" for="to">To</label>
        <input class="form-control form-control-sm" type="date" id="to" name="to"
               value="@Model.To.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button class="btn btn-sm btn-primary" type="submit">Show</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <div class="text-muted small">Money out</div>
                <div class="fs-3 fw-semibold">&#2547; @Model.TotalCashOut.ToString("N0")</div>
                <div class="text-muted small">what actually left the business</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Rises with every parcel</div>
                <div class="fs-4 fw-semibold">&#2547; @Model.CostOfSale.ToString("N0")</div>
                <div class="text-muted small">courier charges, packaging, payment fees</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Costs of being open</div>
                <div class="fs-4 fw-semibold">&#2547; @Model.Operating.ToString("N0")</div>
                <div class="text-muted small">advertising, rent, wages, software</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Where it went</div>

    @if (Model.CashOut.Count == 0)
    {
        <div class="card-body text-muted">
            Nothing was recorded as going out in this period.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>What</th>
                        <th class="text-end">Entries</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.CashOut)
                    {
                        <tr>
                            <td>
                                @row.Name
                                @if (row.IsCostOfSale)
                                {
                                    <span class="badge text-bg-light border ms-1">per parcel</span>
                                }
                            </td>
                            <td class="text-end">@row.Entries</td>
                            <td class="text-end">@row.Amount.ToString("N0")</td>
                            <td class="text-end text-muted">@row.ShareOfTotal.ToString("N1")%</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td>Total</td>
                        <td></td>
                        <td class="text-end">&#2547; @Model.TotalCashOut.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Transfers between the till, bKash and the bank are left out &mdash; moving
            your own money is not spending it.
        </div>
    }
</div>

@* Advertising is the line most owners come here for, so the expense kind is
   opened up rather than left as one total. *@
@if (Model.Expenses.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">Expenses, by category</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-end">Entries</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Expenses)
                    {
                        <tr>
                            <td>
                                @row.CategoryName
                                @if (row.IsCostOfSale)
                                {
                                    <span class="badge text-bg-light border ms-1">per parcel</span>
                                }
                            </td>
                            <td class="text-end">@row.Entries</td>
                            <td class="text-end">@row.Amount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Facebook and Instagram spending is recorded under <strong>Advertising</strong>.
            Record it in Finance &rarr; Cash as it is paid, and it appears here.
        </div>
    </div>
}

@* Kept apart from the money-out table above, and never added to it. *@
<div class="card">
    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
        <span>Stock bought</span>
        <span class="text-muted small">@Model.PurchaseReceipts receipt(s)</span>
    </div>

    @if (Model.Purchases.Count == 0)
    {
        <div class="card-body text-muted">No stock was received in this period.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th class="text-end">Receipts</th>
                        <th class="text-end">Goods</th>
                        <th class="text-end">Freight etc.</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Purchases)
                    {
                        <tr>
                            <td>@row.SupplierName</td>
                            <td class="text-end">@row.Receipts</td>
                            <td class="text-end">@row.Goods.ToString("N0")</td>
                            <td class="text-end">
                                @(row.Charges == 0m ? "" : row.Charges.ToString("N0"))
                            </td>
                            <td class="text-end fw-semibold">@row.Total.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="4">Total bought</td>
                        <td class="text-end">&#2547; @Model.TotalPurchased.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <div class="card-footer small">
        <strong>This is not the same as money out, and the two are never added.</strong>
        Stock bought is what arrived, whether or not it has been paid for. Money paid
        to suppliers is in the table above. Buying on credit is a purchase with no cash
        out; settling last month's bill is cash out with no purchase.
    </div>
</div>
